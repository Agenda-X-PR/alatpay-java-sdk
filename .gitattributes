# Auto-detect text files and normalize line endings
* text=auto

# Shell scripts should always use LF
*.sh text eol=lf

# Batch files should always use CRLF
*.bat text eol=crlf

# Java source files use LF
*.java text eol=lf

# Markdown and text files use LF
*.md text eol=lf
*.txt text eol=lf

# YAML files use LF
*.yml text eol=lf
*.yaml text eol=lf

# XML and Maven files use LF
*.xml text eol=lf
pom.xml text eol=lf

# Git files use LF
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files — don't touch
*.jar binary
*.zip binary
*.png binary
*.jpg binary
*.gif binary